{
  "name": "bill-collector",
  "version": "1.0.0",
  "description": "AI-powered expense receipt scanner - captures bills and receipts from WhatsApp, Telegram, or email, extracts data via OCR, and syncs to QuickBooks/Xero",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "fuse.js": "^7.0.0",
    "imap": "^0.8.19",
    "intuit-oauth": "^4.1.0",
    "mailparser": "^3.7.1",
    "multer": "^1.4.5-lts.1",
    "node-quickbooks": "^2.0.36",
    "node-telegram-bot-api": "^0.66.0",
    "p-queue": "^8.0.1",
    "sharp": "^0.34.5",
    "twilio": "^5.4.0",
    "uuid": "^11.0.0",
    "winston": "^3.17.0",
    "xero-node": "^9.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/imap": "^0.8.40",
    "@types/jest": "^29.5.0",
    "@types/mailparser": "^3.4.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
